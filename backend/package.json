{
  "name": "parley-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node + Express backend for the Parley AI chatbot SaaS platform",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "test": "node --test test/*.test.js",
    "gen:secrets": "node scripts/gen-secrets.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0",
    "socket.io": "^4.8.4",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.25.76"
  }
}
